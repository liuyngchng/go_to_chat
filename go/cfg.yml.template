# go_to_chat AI客服系统配置文件
# 将此文件复制为 cfg.yml 并修改配置
server:
  port: 19007
  debug: true

sys:
  name: 对话机器人
  auth: false

# LLM / Embedding API 配置请在系统管理页面中设置，无需写入此文件

# Milvus 向量数据库配置
milvus:
  # Milvus 服务地址，留空则使用本地嵌入式向量存储
  # 远程示例: http://localhost:19530
  uri: ""
  # Milvus 认证 token (可选)
  token: ""
